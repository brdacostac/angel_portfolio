---
const videoReel = {
  title: "Acting Reel 2025",
  embedUrl: "", /* Replace with YouTube/Vimeo embed URL */
};
---

<section class="reels section" id="video-reel">
  <div class="container">
    <div class="reels-header reveal">
      <span class="section-label">Reels</span>
      <h2>Get a <em>taste</em></h2>
    </div>

    <div class="reels-grid reveal reveal-delay-1">

      <!-- Voice Reel — LEFT -->
      <div class="reel-column">
        <p class="reel-col-label">Voice Reel</p>
        <div class="reel-card reel-card--voice">
          <div class="waveform" id="waveform">
            {Array.from({ length: 36 }).map((_, i) => {
              const h = 20 + Math.sin(i * 0.5) * 28 + Math.cos(i * 0.9) * 14;
              return <div class="wave-bar" style={`height: ${h}%`} />;
            })}
          </div>

          <div class="audio-player">
            <audio id="voice-audio" src="/AngelKahealani_VoiceReel.mp3" preload="metadata"></audio>

            <!-- Play button -->
            <button class="play-btn" id="play-btn" aria-label="Play voice reel">
              <svg class="icon-play" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <polygon points="5,3 15,9 5,15" fill="currentColor"/>
              </svg>
              <svg class="icon-pause" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <rect x="4" y="3" width="3.5" height="12" rx="1" fill="currentColor"/>
                <rect x="10.5" y="3" width="3.5" height="12" rx="1" fill="currentColor"/>
              </svg>
            </button>

            <!-- Right: progress + volume stacked -->
            <div class="audio-right">
              <div class="audio-row">
                <input
                  type="range"
                  id="seek-slider"
                  class="seek-slider"
                  min="0"
                  max="100"
                  step="0.1"
                  value="0"
                  aria-label="Seek audio"
                />
                <span class="audio-time" id="audio-time">0:00</span>
              </div>

              <div class="audio-row">
                <div class="volume-control">
                  <svg id="vol-icon" width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2 5H4.5L7 2.5V11.5L4.5 9H2V5Z" fill="currentColor"/>
                    <path class="vol-wave-1" d="M9 4.5C9.8 5.2 10.3 6 10.3 7C10.3 8 9.8 8.8 9 9.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    <path class="vol-wave-2" d="M10.5 2.5C12 3.7 13 5.3 13 7C13 8.7 12 10.3 10.5 11.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                  <input
                    type="range"
                    id="volume-slider"
                    class="volume-slider"
                    min="0"
                    max="1"
                    step="0.02"
                    value="1"
                    aria-label="Volume"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Video Reel — RIGHT -->
      <div class="reel-column">
        <p class="reel-col-label">Video Reel</p>
        <div class="reel-card reel-card--video">
          {videoReel.embedUrl ? (
            <iframe
              src={videoReel.embedUrl}
              title={videoReel.title}
              allowfullscreen
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            ></iframe>
          ) : (
            <>
              <div class="placeholder-icon">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <circle cx="24" cy="24" r="23" stroke="currentColor" stroke-width="1"/>
                  <polygon points="19,14 19,34 36,24" fill="currentColor"/>
                </svg>
              </div>
              <p class="reel-placeholder-text">Video reel coming soon</p>
            </>
          )}
        </div>
      </div>

    </div>
  </div>

  <div class="section-line"></div>
</section>

<style>
  .reels {
    background: var(--bg-alt);
  }

  .reels-header {
    margin-bottom: var(--space-lg);
  }

  .reels-header h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.05;
  }

  /* explicit selector to guarantee accent color on em */
  .reels-header h2 em {
    color: var(--accent);
    font-style: italic;
  }

  /* Two columns, side-by-side — voice LEFT, video RIGHT */
  .reels-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .reel-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  /* Column label sitting above each card */
  .reel-col-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold);
    max-width: none;
  }

  .reel-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
  }

  .reel-card--voice {
    padding: var(--space-lg) var(--space-md);
    min-height: 220px;
  }

  .reel-card--video {
    aspect-ratio: 16 / 9;
  }

  .reel-card--video iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Waveform */
  .waveform {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 72px;
    width: 100%;
    justify-content: center;
  }

  .wave-bar {
    width: 3px;
    background: var(--accent);
    opacity: 0.4;
    border-radius: 2px;
    animation: wavePulse 3s ease-in-out infinite;
  }

  .wave-bar:nth-child(odd) { animation-delay: 0.15s; }
  .wave-bar:nth-child(3n) { animation-delay: 0.35s; }

  @keyframes wavePulse {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 0.6; }
  }

  /* Audio Player */
  .audio-player {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: 0 var(--space-xs);
  }

  .play-btn {
    flex-shrink: 0;
    align-self: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--duration) var(--ease), color var(--duration) var(--ease);
  }

  .play-btn:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .icon-pause { display: none; }
  .audio-player.playing .icon-play  { display: none; }
  .audio-player.playing .icon-pause { display: block; }

  /* Right side: two rows stacked */
  .audio-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
    min-width: 0;
  }

  /* Each row: bar + label side by side */
  .audio-row {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  /* Seek slider */
  .seek-slider {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: rgba(232, 104, 138, 0.18);
    outline: none;
    cursor: pointer;
    min-width: 0;
  }

  .seek-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    transition: transform var(--duration) var(--ease);
  }

  .seek-slider::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: none;
    background: var(--accent);
    cursor: pointer;
  }

  .seek-slider:hover::-webkit-slider-thumb {
    transform: scale(1.3);
  }

  .audio-time {
    font-size: 0.72rem;
    color: var(--text-light);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    min-width: 3ch;
    text-align: right;
  }

  /* Volume row */
  .volume-control {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
  }

  .volume-control svg {
    color: var(--text-light);
    flex-shrink: 0;
  }

  .vol-wave-1,
  .vol-wave-2 {
    transition: opacity var(--duration) var(--ease);
  }

  .volume-slider {
    -webkit-appearance: none;
    appearance: none;
    height: 3px;
    border-radius: 2px;
    background: rgba(232, 104, 138, 0.18);
    outline: none;
    cursor: pointer;
  }

  .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    transition: transform var(--duration) var(--ease);
  }

  .volume-slider::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: none;
    background: var(--accent);
    cursor: pointer;
  }

  .volume-slider:hover::-webkit-slider-thumb {
    transform: scale(1.3);
  }

  /* Waveform playing state */
  .waveform.playing .wave-bar {
    animation: wavePulse 0.8s ease-in-out infinite;
  }

  /* Placeholder */
  .placeholder-icon {
    color: var(--accent);
    opacity: 0.35;
  }

  .reel-placeholder-text {
    font-size: 0.8rem;
    color: var(--text-light);
    letter-spacing: 0.05em;
    max-width: none;
  }

  .section-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  /* Stack only below 600px — keeps two columns at 800px+ */
  @media (max-width: 600px) {
    .reels-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const audio      = document.getElementById('voice-audio')  as HTMLAudioElement;
  const playBtn    = document.getElementById('play-btn')      as HTMLButtonElement;
  const player     = playBtn?.closest('.audio-player')        as HTMLElement;
  const seekSlider = document.getElementById('seek-slider')   as HTMLInputElement;
  const timeEl     = document.getElementById('audio-time')    as HTMLElement;
  const waveform   = document.getElementById('waveform')      as HTMLElement;
  const volSlider  = document.getElementById('volume-slider') as HTMLInputElement;
  const volWave1   = document.querySelector('.vol-wave-1')    as SVGElement;
  const volWave2   = document.querySelector('.vol-wave-2')    as SVGElement;

  function fmt(s: number) {
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60).toString().padStart(2, '0');
    return `${m}:${sec}`;
  }

  function updateFill(slider: HTMLInputElement) {
    const pct = (Number(slider.value) / Number(slider.max)) * 100;
    slider.style.background = `linear-gradient(to right, var(--accent) ${pct}%, rgba(232,104,138,0.18) ${pct}%)`;
  }

  // Play / pause
  playBtn?.addEventListener('click', () => {
    audio.paused ? audio.play() : audio.pause();
  });

  audio?.addEventListener('play', () => {
    player?.classList.add('playing');
    waveform?.classList.add('playing');
    playBtn?.setAttribute('aria-label', 'Pause voice reel');
  });

  audio?.addEventListener('pause', () => {
    player?.classList.remove('playing');
    waveform?.classList.remove('playing');
    playBtn?.setAttribute('aria-label', 'Play voice reel');
  });

  audio?.addEventListener('ended', () => {
    player?.classList.remove('playing');
    waveform?.classList.remove('playing');
    if (seekSlider) { seekSlider.value = '0'; updateFill(seekSlider); }
    if (timeEl) timeEl.textContent = '0:00';
    playBtn?.setAttribute('aria-label', 'Play voice reel');
  });

  // Sync seek slider as audio plays
  let isSeeking = false;

  audio?.addEventListener('timeupdate', () => {
    if (!audio.duration || isSeeking) return;
    const pct = (audio.currentTime / audio.duration) * 100;
    if (seekSlider) { seekSlider.value = String(pct); updateFill(seekSlider); }
    if (timeEl) timeEl.textContent = fmt(audio.currentTime);
  });

  audio?.addEventListener('loadedmetadata', () => {
    if (seekSlider) seekSlider.max = '100';
  });

  // Drag to seek
  seekSlider?.addEventListener('mousedown', () => { isSeeking = true; });
  seekSlider?.addEventListener('touchstart', () => { isSeeking = true; });

  seekSlider?.addEventListener('input', () => {
    updateFill(seekSlider);
    if (audio.duration) {
      if (timeEl) timeEl.textContent = fmt((Number(seekSlider.value) / 100) * audio.duration);
    }
  });

  seekSlider?.addEventListener('change', () => {
    if (audio.duration) audio.currentTime = (Number(seekSlider.value) / 100) * audio.duration;
    isSeeking = false;
  });

  // Volume
  function updateVolIcon(val: number) {
    if (volWave1) volWave1.style.opacity = val > 0 ? '1' : '0';
    if (volWave2) volWave2.style.opacity = val > 0.4 ? '1' : '0';
  }

  volSlider?.addEventListener('input', () => {
    audio.volume = Number(volSlider.value);
    updateVolIcon(audio.volume);
    updateFill(volSlider);
  });

  // Init fills
  if (seekSlider) updateFill(seekSlider);
  if (volSlider)  { updateFill(volSlider); updateVolIcon(1); }
</script>
